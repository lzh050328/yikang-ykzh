# 复制为 .env 后填写实际值；.env 已被 .gitignore 忽略，切勿提交
# 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# 业务 Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 向量库专用 Redis
VECTOR_REDIS_HOST=localhost
VECTOR_REDIS_PORT=6378

# Spring Profile：dev / test / prod
SPRING_PROFILES_ACTIVE=dev

# 大模型
DEEPSEEK_API_KEY=
DIFY_BASE_URL=http://localhost/v1
DIFY_API_KEY=

# 微信小程序
WECHAT_APPID=
WECHAT_SECRET=

# 阿里云 OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=

# 华为云 IoTDA
HUAWEI_IOT_AK=
HUAWEI_IOT_SK=
HUAWEI_IOT_REGION=cn-north-4
HUAWEI_IOT_ENDPOINT=
HUAWEI_IOT_PROJECT_ID=
HUAWEI_IOT_AMQP_HOST=
HUAWEI_IOT_AMQP_ACCESS_KEY=
HUAWEI_IOT_AMQP_ACCESS_CODE=

# JWT 签名密钥，生产环境务必替换为随机值
TOKEN_SECRET=change-me-in-production
