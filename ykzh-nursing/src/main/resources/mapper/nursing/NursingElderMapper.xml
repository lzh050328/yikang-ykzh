<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xhzb.nursing.mapper.NursingElderMapper">

    <!-- 查询负责指定老人的护理员（RoomMapper.selectByFloorIdWithNur 的嵌套查询使用） -->
    <select id="selectUserByElderId" resultType="com.xhzb.common.core.domain.entity.SysUser">
        select su.user_id as userId,
               su.nick_name
        from nursing_elder ne
                 inner join sys_user su on su.user_id = ne.nursing_id
        where ne.elder_id = #{elderId}
    </select>

</mapper>
